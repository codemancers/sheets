{
  "name": "@codemancers/sheets",
  "version": "0.2.2",
  "description": "Spreadsheet-style data grid for React: headless hooks on TanStack Table, plus Tailwind v4 components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemancers/sheets.git",
    "directory": "packages/sheets"
  },
  "homepage": "https://github.com/codemancers/sheets#readme",
  "bugs": "https://github.com/codemancers/sheets/issues",
  "keywords": [
    "react",
    "tanstack-table",
    "data-grid",
    "spreadsheet",
    "sheet",
    "tailwindcss",
    "headless"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@codemancers/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "@codemancers/source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "publint": {
        "command": "pnpm dlx publint@0.3",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.3.1",
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-table": "^9.3.1"
  }
}
